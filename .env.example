# CloakBrowser Manager production environment

# Public domain used by the Caddy reverse proxy.
CLOAK_DOMAIN=cloak.example.com

# Web login account. The first startup stores this account in SQLite.
# Later changes can be made from the web UI: top-right key icon -> account settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Optional API token for scripts using Authorization: Bearer <token>.
# Leave empty if you only need the web username/password login.
AUTH_TOKEN=

# Optional fixed session signing secret. Leave empty for normal installs.
SESSION_SECRET=

# Linux servers should use the CloakBrowser/Chromium engine.
CLOAKBROWSER_MANAGER_ENGINE=cloakbrowser
